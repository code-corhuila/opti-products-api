# Variables read by the service (see deploy/compose.yml). Copy to .env, which git ignores.
PRODUCTS_DB_NAME=products
PRODUCTS_DB_USER=products_owner
PRODUCTS_DB_PASSWORD=<same-password-as-opti-products-db>
# Public key of the identity service, PEM on one line with literal \n (see opti-infra/scripts/dev-keys.sh)
JWT_PUBLIC_KEY=<pem-public-key-one-line>

# Optional for the persistence integration test (skipped when empty):
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/products?user=<user>&password=<password>
